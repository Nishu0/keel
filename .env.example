# keel configuration. copy to .env at the repo root and fill in.
# the api, worker and web app all read this file. never commit .env.

# ---------- core ----------
# public urls, used for oauth redirects, magic links and cookies
KEEL_PUBLIC_URL=http://localhost:3000
KEEL_API_URL=http://localhost:8000

# mongodb with a replica set (change streams need it). leave empty for the in memory store.
KEEL_MONGO_URL=mongodb://localhost:27017/?replicaSet=rs0

# signs session cookies. any long random string: `openssl rand -base64 48`
KEEL_SESSION_SECRET=

# encrypts org secrets at rest (aes-gcm). 32 random bytes, base64: `openssl rand -base64 32`
# hosted deployments use aws kms instead; set KEEL_KMS_KEY_ID and leave this empty.
KEEL_MASTER_KEY=
KEEL_KMS_KEY_ID=

# ---------- sign in ----------
# github oauth app: https://github.com/settings/developers
#   callback url: $KEEL_PUBLIC_URL/api/keel/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# google oauth client: https://console.cloud.google.com/apis/credentials
#   authorized redirect uri: $KEEL_PUBLIC_URL/api/keel/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# email magic links and invites, sent with resend: https://resend.com/api-keys
RESEND_API_KEY=
KEEL_EMAIL_FROM=keel <login@yourdomain.com>

# ---------- models ----------
# keel provided model access. orgs can also bring their own key as a secret.
ANTHROPIC_API_KEY=
# claude on amazon bedrock (optional). credentials come from the usual aws chain.
AWS_REGION=us-east-1

# ---------- billing ----------
# stripe: https://dashboard.stripe.com/apikeys  (use test keys locally)
STRIPE_SECRET_KEY=
# from `stripe listen --forward-to localhost:8000/v1/webhooks/stripe` or the dashboard webhook
STRIPE_WEBHOOK_SECRET=
# price ids for the paid plans
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# ---------- workers and sandbox ----------
# anthropic (default), bedrock, demo (scripted, no model) or fake (echo)
KEEL_PROVIDER=anthropic
# docker to enable run_python and run_shell; runsc to run them under gvisor
KEEL_SANDBOX=
KEEL_SANDBOX_RUNTIME=
KEEL_WORKER_CONCURRENCY=4

# ---------- safety and limits ----------
# 1 only when the api sits behind a proxy you run (the web app's /api/keel proxy, or caddy):
# then X-Forwarded-For is trusted for per ip rate limits. Leave empty if the api is exposed directly.
KEEL_TRUST_FORWARDED=
# tool outputs bigger than this are stored as a preview (bytes, default 262144)
KEEL_MAX_TOOL_OUTPUT_BYTES=
# the worker touches this file every 5s for container healthchecks
KEEL_WORKER_HEARTBEAT_FILE=/tmp/keel-worker-alive

# ---------- local development only ----------
# a fixed api key for the single org dev mode, and running a worker inside the api process
KEEL_DEV_API_KEY=
KEEL_DEV_ORG=org_local
KEEL_EMBEDDED_WORKER=
# 1 lets tools call localhost and private addresses (local mcp servers, webhooks on your laptop).
# Never set this in production: it turns off the protection against agents reaching internal hosts.
KEEL_ALLOW_PRIVATE_NETWORK=
